# ADSTREAM Environment Configuration

# Server
PORT=3000
NODE_ENV=development

# Database Configuration
# Use 'sqlite' for development or 'postgres' for production
DB_TYPE=sqlite

# SQLite Configuration (development)
SQLITE_DB_PATH=./data/adstream.db

# PostgreSQL Configuration (production)
DATABASE_URL=postgresql://user:password@localhost:5432/adstream

# Security
SECRET_KEY=your-secret-key-here-change-in-production
API_KEY_HEADER=x-api-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=1000

# Performance
AD_REQUEST_TIMEOUT_MS=100
IMPRESSION_BATCH_INTERVAL_MS=5000
DB_POOL_MIN=5
DB_POOL_MAX=20

# Logging
LOG_LEVEL=info
DEBUG=false

# Cache
CACHE_TTL_SECONDS=300
